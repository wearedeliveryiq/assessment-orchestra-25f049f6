  "patterns": [
    {
      "id": "pat_governance_sponsorship_gap",
      "version": "1.0.0",
      "order": 1,
      "priority": 100,
      "severity": "critical",
      "exclusiveGroup": "leadership_control_state",
      "minimumCapabilityConfidence": 50,
      "predicates": [
        { "capability": "governance", "operator": "lt", "value": 50 },
        { "capability": "sponsorship", "operator": "lt", "value": 50 }
      ],
      "explanation": "Governance and executive sponsorship both need attention, increasing the risk that decisions and accountability will not support delivery."
    },
    {
      "id": "pat_execution_without_control",
      "version": "1.0.0",
      "order": 2,
      "priority": 80,
      "severity": "high",
      "exclusiveGroup": "delivery_balance_state",
      "minimumCapabilityConfidence": 50,
      "predicates": [
        {
          "aggregate": "mean",
          "capabilities": ["programme_delivery", "project_delivery"],
          "operator": "gte",
          "value": 50
        },
        {
          "aggregate": "mean",
          "capabilities": ["governance", "planning_controls"],
          "operator": "lt",
          "value": 50
        },
        {
          "difference": {
            "leftMean": ["programme_delivery", "project_delivery"],
            "rightMean": ["governance", "planning_controls"]
          },
          "operator": "gte",
          "value": 25
        }
      ],
      "explanation": "Delivery activity is stronger than the governance and control environment supporting it."
    },
    {
      "id": "pat_strategy_execution_disconnect",
      "version": "1.0.0",
      "order": 3,
      "priority": 80,
      "severity": "high",
      "exclusiveGroup": "delivery_balance_state",
      "minimumCapabilityConfidence": 50,
      "predicates": [
        { "capability": "strategy_alignment", "operator": "gte", "value": 50 },
        {
          "aggregate": "mean",
          "capabilities": ["programme_delivery", "project_delivery"],
          "operator": "lt",
          "value": 50
        }
      ],
      "explanation": "Strategic direction is clearer than the organisation’s ability to translate it into consistent delivery."
    },
    {
      "id": "pat_benefits_blind_spot",
      "version": "1.0.0",
      "order": 4,
      "priority": 80,
      "severity": "high",
      "exclusiveGroup": "value_visibility_state",
      "minimumCapabilityConfidence": 50,
      "predicates": [
        { "capability": "benefits", "operator": "lt", "value": 50 },
        { "capability": "reporting_insight", "operator": "lt", "value": 50 }
      ],
      "explanation": "Benefits ownership and delivery insight both need attention, limiting visibility of whether change is creating value."
    },
    {
      "id": "pat_resilient_delivery_foundation",
      "version": "1.0.0",
      "order": 5,
      "priority": 40,
      "severity": "positive",
      "exclusiveGroup": "leadership_control_state",
      "minimumCapabilityConfidence": 50,
      "predicates": [
        { "capability": "governance", "operator": "gte", "value": 50 },
        { "capability": "planning_controls", "operator": "gte", "value": 50 },
        { "capability": "risk_assurance", "operator": "gte", "value": 50 }
      ],
      "explanation": "Governance, planning and risk evidence indicate a comparatively resilient foundation for delivery."
    },
    {
      "id": "pat_learning_system",
      "version": "1.0.0",
      "order": 6,
      "priority": 40,
      "severity": "positive",
      "exclusiveGroup": "value_visibility_state",
      "minimumCapabilityConfidence": 50,
      "predicates": [
        { "capability": "reporting_insight", "operator": "gte", "value": 75 },
        { "capability": "continuous_improvement", "operator": "gte", "value": 75 }
      ],
      "explanation": "Strong delivery insight and continuous-improvement practices indicate an active learning system."
    }
  ],
