  "confidence": {
    "storagePrecisionDecimals": 6,
    "displayPrecisionDecimals": 0,
    "roundingMode": "half_up",
    "factors": [
      {
        "id": "required_completion",
        "weight": 0.35,
        "method": "eligible_required_answers/required_questions"
      },
      { "id": "capability_coverage", "weight": 0.25, "method": "available_capabilities/13" },
      {
        "id": "response_consistency",
        "weight": 0.2,
        "method": "mean(1-min(population_sd(normalised_eligible_answers)/50,1))"
      },
      {
        "id": "evidence_recency",
        "weight": 0.1,
        "method": "mean(recency_bucket)",
        "buckets": [
          { "maximumDays": 90, "value": 1 },
          { "maximumDays": 180, "value": 0.75 },
          { "maximumDays": 365, "value": 0.5 },
          { "maximumDays": null, "value": 0.25 }
        ],
        "missingValue": 0
      },
      {
        "id": "respondent_breadth",
        "weight": 0.1,
        "method": "verified_distinct_group_bucket",
        "buckets": [
          { "groups": 0, "value": 0 },
          { "groups": 1, "value": 0.4 },
          { "groups": 2, "value": 0.7 },
          { "minimumGroups": 3, "value": 1 }
        ]
      }
    ],
    "formula": "100*sum(factor.value*factor.weight)",
    "bands": [
      { "id": "low", "minimumInclusive": 0, "maximumExclusive": 50 },
      { "id": "moderate", "minimumInclusive": 50, "maximumExclusive": 75 },
      { "id": "high", "minimumInclusive": 75, "maximumInclusive": 100 }
    ],
    "limitationThresholdExclusive": 0.75,
    "limitations": {
      "required_completion": {
        "text": "Some required evidence is missing.",
        "prompt": "Complete the unanswered required questions."
      },
      "capability_coverage": {
        "text": "The evidence does not cover enough delivery capabilities.",
        "prompt": "Provide evidence across all Delivery DNA capabilities."
      },
      "response_consistency": {
        "text": "Some responses within a capability vary materially.",
        "prompt": "Review the underlying evidence with relevant stakeholders."
      },
      "evidence_recency": {
        "text": "Some evidence may no longer reflect current practice.",
        "prompt": "Refresh evidence older than 180 days."
      },
      "respondent_breadth": {
        "text": "The result represents a limited range of perspectives.",
        "prompt": "Invite evidence from at least three relevant stakeholder groups."
      }
    }
  },
