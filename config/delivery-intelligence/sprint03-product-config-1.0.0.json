  "teamMatePolicy": {
    "activationPrerequisites": [
      "authenticated_workspace",
      "accepted_mapped_recommendation",
      "teammate.activate_permission"
    ],
    "availableEntitledCta": "review_activation",
    "availableNotEntitledCta": "view_teammate",
    "publicDisclosure": "none",
    "copyTemplate": "The {name} can help your team {supportedOutcome}. Review its scope and permissions before activation."
  },
  "narrative": {
    "workspaceWordLimit": 600,
    "publicWordLimit": 80,
    "sectionLimits": {
      "overall_position": 45,
      "confidence": 35,
      "strength_item": 30,
      "opportunity_item": 35,
      "recommendation_item": 40
    },
    "templates": {
      "overall_position": "Your overall delivery capability is {overallBand} at {overallDisplayScore}. {leadingFact} {priorityFact}",
      "confidence": "Confidence in this result is {confidenceBand}. {confidenceLimitationSummary}",
      "strength": "{capabilityLabel} is a relative strength, supported by a score of {displayScore} and {confidenceBand} evidence confidence.",
      "opportunity": "{capabilityLabel} is a priority opportunity, with a score of {displayScore}. {opportunityReason}",
      "recommendation": "{recommendationTitle}. This is recommended because {reasonText} Expected outcome: {expectedOutcome}",
      "lowConfidenceCaveat": "This result is directional because the available evidence has low confidence. Validate the priority areas before committing material action.",
      "overallUnavailableCaveat": "An overall delivery position is not available because fewer than nine capabilities have sufficient evidence."
    },
    "tone": ["executive", "neutral", "constructive", "concise", "evidence_led", "non_alarmist"],
    "prohibitedClaims": [
      "causal_certainty",
      "guarantee",
      "legal_compliance",
      "regulatory_compliance",
      "cross_organisation_comparison",
      "predictive_success_or_failure",
      "respondent_intent",
      "untraced_root_cause"
    ]
  },
  "explainability": {
    "requiredFields": [
      "outputId",
      "outputType",
      "reasonCode",
      "reasonText",
      "evidenceSummary",
      "capabilityIds",
      "confidenceBand",
      "ruleId",
      "ruleVersion",
      "configurationSetId",
      "analysisRunId",
      "traceIds"
    ],
    "publicEvidenceFields": [],
    "restricted": [
      "source_code",
      "sql",
      "prompts",
      "system_messages",
      "secrets",
      "internal_exceptions",
      "rule_expression_text",
      "other_tenant_data",
      "public_rank_weights",
      "security_reasons",
      "entitlement_reasons",
      "chain_of_thought"
    ]
  },
  "publicDisclosure": {
    "allowList": [
      "schemaVersion",
      "resultId",
      "generatedAt",
      "overall.displayScore",
      "overall.band",
      "confidence.band",
      "confidence.caveat",
      "summary",
      "strengths[].title",
      "strengths[].summary",
      "opportunities[].title",
      "opportunities[].summary",
      "recommendationPreviews[].title",
      "recommendationPreviews[].impact",
      "recommendationPreviews[].summary",
      "registrationPrompt.label",
      "registrationPrompt.destination"
    ],
    "limits": { "strengths": 3, "opportunities": 3, "recommendationPreviews": 3 },
    "token": {
      "entropyBits": 256,
      "stored": "hashed",
      "audience": "delivery-dna-public-result",
      "lifetimeSeconds": 86400
    },
    "cacheControl": "private, no-store",
    "rateLimits": {
      "perTokenPerMinute": 30,
      "perTokenPer24Hours": 300,
      "perIpPerMinute": 60,
      "perIpPer24Hours": 1000
    },
    "registrationPrompt": "Create your free DeliveryIQ account to unlock your full report, improvement roadmap and recommended next steps.",
    "registrationDestination": "/register?source=delivery-dna&result={publicResultId}",
    "linking": "verified_authenticated_explicit_consent_single_tenant_workspace_immutable_run"
  },
  "analysisLifecycle": {
    "states": ["queued", "running", "completed", "failed"],
    "transitions": [
      "queued:running",
      "running:completed",
      "queued:failed",
      "running:failed",
      "failed:queued"
    ],
    "completedTerminal": true,
    "maximumAttempts": 3,
    "retryBackoffSeconds": [5, 30],
    "apiMode": "asynchronous_only",
    "idempotencyMaterial": [
      "tenantId",
      "workspaceId",
      "assessmentId",
      "assessmentRevision",
      "configurationSetId",
      "requestedMode"
    ],
    "idempotencySeparator": "\n",
    "idempotencyDigest": "sha256"
  },
  "traceability": {
    "nodeTypes": [
