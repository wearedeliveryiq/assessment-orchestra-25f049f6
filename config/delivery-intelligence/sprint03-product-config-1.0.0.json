      "exclusions": [],
      "dependencies": [],
      "outcome": "Executive sponsorship has explicit accountabilities and intervention routines.",
      "successMeasures": [
        "Named sponsor accountabilities are agreed",
        "Sponsor decisions and barrier-removal actions are reviewed monthly"
      ]
    },
    {
      "id": "rec_integrated_controls",
      "order": 3,
      "title": "Establish an integrated planning and controls baseline",
      "impact": "high",
      "effort": "high",
