  "recommendations": [
    {
      "id": "rec_decision_rights",
      "order": 1,
      "title": "Define decision rights and governance cadence",
      "impact": "high",
      "effort": "medium",
      "dedupeGroup": "governance_foundation",
      "triggers": {
        "any": [{ "opportunity": "governance" }, { "pattern": "pat_governance_sponsorship_gap" }]
      },
      "exclusions": [],
      "dependencies": [],
      "outcome": "Decisions have clear owners, forums, thresholds and cadence.",
      "successMeasures": [
        "100% of priority decision types have an accountable owner",
        "Governance calendar and escalation thresholds are published"
      ]
    },
    {
      "id": "rec_sponsor_contract",
      "order": 2,
      "title": "Establish an active sponsor contract",
      "impact": "high",
      "effort": "medium",
