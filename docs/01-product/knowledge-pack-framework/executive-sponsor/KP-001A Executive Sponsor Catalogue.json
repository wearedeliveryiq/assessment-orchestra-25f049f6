  "questions": [
    {
      "id": "kp001.strategic_alignment.01",
      "capabilityId": "strategic_alignment",
      "weight": 0.2,
      "required": true,
      "text": "Is there a clearly defined business case with measurable outcomes?"
    },
    {
      "id": "kp001.strategic_alignment.02",
      "capabilityId": "strategic_alignment",
      "weight": 0.2,
      "required": true,
      "text": "Are the initiative’s objectives aligned to organisational strategy?"
    },
    {
      "id": "kp001.strategic_alignment.03",
      "capabilityId": "strategic_alignment",
      "weight": 0.2,
      "required": true,
      "text": "Are the expected benefits understood and agreed by accountable stakeholders?"
    },
    {
      "id": "kp001.strategic_alignment.04",
      "capabilityId": "strategic_alignment",
      "weight": 0.2,
      "required": true,
      "text": "Is there a clear and measurable definition of success?"
    },
    {
      "id": "kp001.strategic_alignment.05",
      "capabilityId": "strategic_alignment",
      "weight": 0.2,
      "required": true,
      "text": "Are priorities reviewed when business needs change?"
    },
    {
      "id": "kp001.sponsor_leadership.01",
      "capabilityId": "sponsor_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Does the executive sponsor actively champion the initiative?"
    },
    {
      "id": "kp001.sponsor_leadership.02",
      "capabilityId": "sponsor_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Does the executive sponsor make required decisions within agreed timescales?"
    },
    {
      "id": "kp001.sponsor_leadership.03",
      "capabilityId": "sponsor_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Is executive commitment visible to delivery teams and stakeholders?"
    },
    {
      "id": "kp001.sponsor_leadership.04",
      "capabilityId": "sponsor_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Does the sponsor act to remove organisational barriers?"
    },
    {
      "id": "kp001.sponsor_leadership.05",
      "capabilityId": "sponsor_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Are sponsor and delivery accountabilities explicitly understood?"
    },
    {
      "id": "kp001.governance.01",
      "capabilityId": "governance",
      "weight": 0.2,
      "required": true,
      "text": "Are governance arrangements clearly defined?"
    },
    {
      "id": "kp001.governance.02",
      "capabilityId": "governance",
      "weight": 0.2,
      "required": true,
      "text": "Does governance focus on decisions and interventions rather than status reporting?"
    },
    {
      "id": "kp001.governance.03",
      "capabilityId": "governance",
      "weight": 0.2,
      "required": true,
      "text": "Are key decisions recorded with owners and follow-up actions?"
    },
    {
      "id": "kp001.governance.04",
      "capabilityId": "governance",
      "weight": 0.2,
      "required": true,
      "text": "Are escalation routes and thresholds understood?"
    },
    {
      "id": "kp001.governance.05",
      "capabilityId": "governance",
      "weight": 0.2,
      "required": true,
      "text": "Do governance forums resolve the matters brought to them effectively?"
    },
    {
      "id": "kp001.benefits_realisation.01",
      "capabilityId": "benefits_realisation",
      "weight": 0.2,
      "required": true,
      "text": "Are expected benefits clearly defined and measurable?"
    },
    {
      "id": "kp001.benefits_realisation.02",
      "capabilityId": "benefits_realisation",
      "weight": 0.2,
      "required": true,
      "text": "Does every priority benefit have an accountable owner?"
    },
    {
      "id": "kp001.benefits_realisation.03",
      "capabilityId": "benefits_realisation",
      "weight": 0.2,
      "required": true,
      "text": "Are benefit baselines, targets and progress reviewed during delivery?"
    },
    {
      "id": "kp001.benefits_realisation.04",
      "capabilityId": "benefits_realisation",
      "weight": 0.2,
      "required": true,
      "text": "Are benefits reviewed after implementation?"
    },
    {
      "id": "kp001.benefits_realisation.05",
      "capabilityId": "benefits_realisation",
      "weight": 0.2,
      "required": true,
      "text": "Do executive decisions consider expected business value?"
    },
    {
      "id": "kp001.risk_assurance.01",
      "capabilityId": "risk_assurance",
      "weight": 0.2,
      "required": true,
      "text": "Does the sponsor have current visibility of material delivery risks?"
    },
    {
      "id": "kp001.risk_assurance.02",
      "capabilityId": "risk_assurance",
      "weight": 0.2,
      "required": true,
      "text": "Are significant risks and uncertainty discussed candidly?"
    },
    {
      "id": "kp001.risk_assurance.03",
      "capabilityId": "risk_assurance",
      "weight": 0.2,
      "required": true,
      "text": "Is independent assurance used where the level of risk warrants it?"
    },
    {
      "id": "kp001.risk_assurance.04",
      "capabilityId": "risk_assurance",
      "weight": 0.2,
      "required": true,
      "text": "Are material mitigation and assurance actions actively monitored?"
    },
    {
      "id": "kp001.risk_assurance.05",
      "capabilityId": "risk_assurance",
      "weight": 0.2,
      "required": true,
      "text": "Are executive intervention thresholds for risk and assurance clear?"
    },
    {
      "id": "kp001.stakeholder_leadership.01",
      "capabilityId": "stakeholder_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Are senior stakeholders actively engaged in the initiative?"
    },
    {
      "id": "kp001.stakeholder_leadership.02",
      "capabilityId": "stakeholder_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Is there alignment across business, delivery and technology leaders?"
    },
    {
      "id": "kp001.stakeholder_leadership.03",
      "capabilityId": "stakeholder_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Are material stakeholder conflicts resolved promptly?"
    },
    {
      "id": "kp001.stakeholder_leadership.04",
      "capabilityId": "stakeholder_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Do stakeholders understand and support key delivery decisions?"
    },
    {
      "id": "kp001.stakeholder_leadership.05",
      "capabilityId": "stakeholder_leadership",
      "weight": 0.2,
      "required": true,
      "text": "Is organisational adoption visibly sponsored?"
    },
    {
      "id": "kp001.delivery_confidence.01",
      "capabilityId": "delivery_confidence",
      "weight": 0.2,
      "required": true,
      "text": "Does the sponsor have evidence-based confidence in delivery capability?"
    },
    {
      "id": "kp001.delivery_confidence.02",
      "capabilityId": "delivery_confidence",
      "weight": 0.2,
      "required": true,
      "text": "Is progress reported clearly, consistently and candidly?"
    },
    {
      "id": "kp001.delivery_confidence.03",
      "capabilityId": "delivery_confidence",
      "weight": 0.2,
      "required": true,
      "text": "Are executive delivery decisions based on current evidence?"
    },
    {
      "id": "kp001.delivery_confidence.04",
      "capabilityId": "delivery_confidence",
      "weight": 0.2,
      "required": true,
      "text": "Are significant issues escalated early enough for effective intervention?"
    },
    {
      "id": "kp001.delivery_confidence.05",
      "capabilityId": "delivery_confidence",
      "weight": 0.2,
      "required": true,
      "text": "Can the sponsor explain the current delivery position and its principal uncertainties?"
    },
    {
      "id": "kp001.continuous_improvement.01",
      "capabilityId": "continuous_improvement",
      "weight": 0.2,
      "required": true,
      "text": "Are lessons captured while delivery is in progress?"
    },
    {
      "id": "kp001.continuous_improvement.02",
      "capabilityId": "continuous_improvement",
      "weight": 0.2,
      "required": true,
      "text": "Are agreed improvement recommendations acted upon?"
    },
    {
      "id": "kp001.continuous_improvement.03",
      "capabilityId": "continuous_improvement",
      "weight": 0.2,
      "required": true,
      "text": "Is delivery capability demonstrably improving over time?"
    },
    {
      "id": "kp001.continuous_improvement.04",
      "capabilityId": "continuous_improvement",
      "weight": 0.2,
      "required": true,
      "text": "Are delivery measures used to guide improvement decisions?"
    },
    {
      "id": "kp001.continuous_improvement.05",
      "capabilityId": "continuous_improvement",
      "weight": 0.2,
      "required": true,
      "text": "Does the sponsor actively promote better ways of delivering change?"
    }
  ],
  "patterns": [
    {
