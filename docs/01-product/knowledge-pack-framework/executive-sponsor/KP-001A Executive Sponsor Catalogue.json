      "explanation": "Leadership, governance, risk and confidence evidence indicate effective executive control."
    },
    {
      "id": "kp001_learning_sponsor",
      "version": "1.0.0",
      "priority": 40,
      "severity": "positive",
      "predicates": [
        ["benefits_realisation", "gte", 75],
        ["continuous_improvement", "gte", 75]
      ],
      "explanation": "The sponsor connects value realisation with continuous learning and improvement."
    }
  ],
