  "fixtures": [
    {
      "id": "commercial_2_saved_snapshot_boundary",
      "input": {"snapshotVersion": "2.0.0", "authenticated": true, "paid": false},
      "expected": {"responsesRetained": 15, "downloadSameResult": true, "additionalIntelligence": false, "remainingQuestionsAccessible": false, "analysisRunCreated": false}
    },
    {
      "id": "commercial_2_verified_payment_grants_one_scope",
      "input": {"eventVerified": true, "status": "succeeded", "amountMinor": 29500, "currency": "GBP", "tenantWorkspaceAssessmentMatch": true},
      "expected": {"accessGrantCount": 1, "accessKey": "delivery_dna_overview", "accessVersion": "2.0.0", "remainingQuestionsAccessible": 30}
    },
    {
      "id": "commercial_2_redirect_without_event_denied",
      "input": {"successRedirectReceived": true, "eventVerified": false},
      "expected": {"accessGrantCount": 0, "safeStatus": "payment_confirmation_pending"}
    },
    {
      "id": "commercial_2_duplicate_event_idempotent",
      "input": {"eventVerified": true, "sameEventDeliveryCount": 3, "tenantWorkspaceAssessmentMatch": true},
      "expected": {"accessGrantCount": 1, "chargeFulfilmentCount": 1}
    },
    {
      "id": "commercial_2_wrong_amount_currency_or_scope_denied",
      "input": {"eventVerified": true, "amountMinor": 29400, "currency": "USD", "tenantWorkspaceAssessmentMatch": false},
      "expected": {"accessGrantCount": 0, "safeStatus": "payment_verification_failed"}
    },
    {
      "id": "commercial_2_no_vat_total",
      "input": {"unitAmountMinor": 29500, "supplierVatRegistered": false, "currency": "GBP"},
      "expected": {"subtotalMinor": 29500, "vatAmountMinor": 0, "customerTotalMinor": 29500, "taxDisplay": "No VAT charged — DeliveryIQ is not VAT registered."}
    },
    {
      "id": "commercial_2_overview_projection_bounded",
      "input": {"overviewAccess": true, "immutableResultVersion": "2.0.0"},
      "expected": {"maximumDomains": 5, "maximumCapabilities": 15, "maximumRecommendations": 3, "downloadableReportSections": 7, "actionControlsAvailable": false}
    },
    {
      "id": "commercial_2_context_is_calculation_neutral",
      "input": {"contextEligible": true, "sourceNotePresent": true},
      "expected": {"displayed": true, "maximumMainDashboardItems": 3, "scoringEffect": "none", "benchmarkClaim": false}
    },
    {
      "id": "commercial_2_version1_history_preserved_without_translation",
      "input": {"historicalVersion": "1.0.0", "newCutoverVersion": "2.0.0"},
      "expected": {"historicalRecordsMutated": false, "responsesTranslated": false, "scoresTranslated": false, "syntheticGrantCreated": false}
    }
