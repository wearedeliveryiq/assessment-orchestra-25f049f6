  "copy": {
    "websiteCta": "Get your free DNA Snapshot",
    "startHeading": "Discover your Delivery DNA Snapshot",
    "introduction": "Answer 13 quick questions to see directional signals across your organisation's delivery practices. No account is required.",
    "timeEstimate": "Approximately 3–5 minutes",
    "instructions": "Choose the option that most closely reflects how your organisation usually works today. Use Not applicable only where a question genuinely does not apply.",
    "preparationHeading": "Building your Delivery DNA Snapshot",
    "preparationBody": "We’re reviewing the patterns across your 13 responses.",
    "slowPreparationBody": "Still preparing your Snapshot",
    "readyHeading": "Your Snapshot is ready",
    "resultHeading": "Your indicative delivery maturity",
    "profileHeading": "Your indicative delivery profile",
    "profileBody": "Based on one practice signal from each Delivery DNA capability.",
    "maturityLevels": {
      "emerging": {
        "label": "Emerging",
        "interpretation": "Delivery practices appear to be at an early or inconsistent stage across the areas assessed."
      },
      "developing": {
        "label": "Developing",
        "interpretation": "Some delivery practices are taking shape, but consistency varies across the areas assessed."
      },
      "established": {
        "label": "Established",
        "interpretation": "Delivery practices appear consistently established across many of the areas assessed."
      },
      "leading": {
        "label": "Leading",
        "interpretation": "The responses indicate strong consistency across the delivery practices assessed."
      }
    },
    "positiveHeading": "Positive signals",
    "exploreHeading": "Areas to explore",
    "positiveCardText": "Your response indicates this practice may be working consistently.",
    "exploreCardText": "Your response indicates this practice may benefit from closer examination.",
    "resultCaveat": "This is an indicative view based on the 13 practices covered by your Snapshot. It is not your complete Delivery DNA result and may change when foundations and supporting evidence are assessed.",
    "insufficientHeading": "A Snapshot is not available yet",
    "insufficientBody": "Answer at least nine applicable questions and provide a response or Not applicable status for all 13 questions.",
    "continuationHeading": "Turn your Snapshot into your complete Delivery DNA",
    "continuationBody": "You’ve already completed 13 of 39 questions. Create your free account to carry these answers forward and discover your complete capability profile, priority recommendations and personalised roadmap preview.",
    "continuationCtaAnonymous": "Complete my Delivery DNA",
    "continuationCtaLinked": "Continue my Delivery DNA",
