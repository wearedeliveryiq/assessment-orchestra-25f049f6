  "maturityPolicy": {
    "id": "snapshot-indicative-maturity",
    "version": "1.0.0",
    "input": "answered_raw_values_only",
    "notApplicableTreatment": "excluded",
    "weighting": "equal_per_answered_question",
    "calculation": "arithmetic_mean",
    "calculationPrecisionMinimumDecimalPlaces": 6,
    "boundaryInput": "unrounded_mean",
    "underlyingValueCustomerVisible": false,
