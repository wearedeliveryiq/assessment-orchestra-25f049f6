        "maximumExclusive": 2.5
      },
      {
        "id": "developing",
        "minimumInclusive": 2.5,
        "maximumExclusive": 3.5
      },
      {
        "id": "established",
        "minimumInclusive": 3.5,
        "maximumExclusive": 4.25
      },
      {
        "id": "leading",
        "minimumInclusive": 4.25,
        "maximumInclusive": 5
      }
    ]
  },
