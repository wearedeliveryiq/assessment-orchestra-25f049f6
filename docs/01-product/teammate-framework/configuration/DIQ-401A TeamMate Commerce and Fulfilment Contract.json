  "authorityNotice": "Fixed policy in this contract is Product Owner-approved release-candidate definition. Values under pendingCommercialDecisions are deliberately not production rules and must remain non-actionable until approved by Matt Prust and promoted in a locked version.",
  "definitions": {
    "purchase": "Authoritative creation or amendment of a commercial subscription/order after a verified provider or authorised contract event.",
    "entitlement": "A tenant-scoped versioned decision that a customer organisation may allocate an approved TeamMate offer subject to availability, permission and activation.",
    "allocation": "An entitlement-backed available slot for one TeamMate type, approved work profile and plan; it is not an active TeamMate instance.",
    "provisioning": "Idempotent preparation of DeliveryIQ organisation, workspace, allocation and onboarding resources.",
    "activation": "Separate DIQ-400 approval of exact TeamMate instance scope, capabilities, data, memory, schedules, integrations and consent.",
    "shipping": "Making the subscribed SaaS allocation ready to configure in DeliveryIQ and providing optional approved client-extension delivery paths."
  },
