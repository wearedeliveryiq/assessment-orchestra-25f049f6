  "workflows": [
    {
      "id": "daily_admin_briefing",
      "version": "1.0.0-rc2",
      "trigger": ["explicit_user_request", "approved_visible_schedule"],
      "reads": [
        "profile_selected_tasks",
        "decisions",
        "meetings",
        "records",
        "measures",
        "schedules"
      ],
      "produces": ["prioritised_briefing", "source_references", "limitations"],
      "maximumRisk": "R1",
      "sideEffect": false
    },
    {
      "id": "meeting_preparation",
      "version": "1.0.0-rc2",
      "trigger": ["explicit_user_request", "approved_visible_schedule"],
      "reads": ["selected_meeting", "approved_profile_context"],
      "produces": [
        "agenda_draft",
        "preparation_notes_draft",
        "decisions_required",
        "task_status",
        "questions"
      ],
      "optionalR2": [
        "insert_into_user_present_unsent_message",
        "update_user_present_unsent_appointment"
      ],
      "maximumRisk": "R2"
    },
    {
      "id": "consented_meeting_follow_up",
      "version": "1.0.0-rc2",
      "trigger": ["explicit_user_request"],
      "prerequisites": ["participant_notice", "capture_consent", "authorised_notes_or_transcript"],
      "produces": ["draft_minutes", "proposed_decisions", "proposed_actions", "follow_up_draft"],
      "humanConfirmationRequired": ["decision_record", "action_creation_or_update"],
      "maximumRisk": "R2"
    },
    {
      "id": "action_follow_through",
      "version": "1.0.0-rc2",
      "trigger": ["explicit_user_request", "approved_visible_schedule"],
      "produces": ["work_queue_exception", "proposed_reminder", "proposed_escalation"],
      "optionalR2": ["schedule_internal_reminder", "update_allow_listed_deliveryiq_action_state"],
      "maximumRisk": "R2"
    },
    {
      "id": "recurring_update_draft",
      "version": "1.0.0-rc2",
      "trigger": ["explicit_user_request", "approved_visible_schedule"],
      "produces": [
        "reconciled_update",
        "missing_stale_or_conflicting_inputs",
        "profile_defined_document_draft",
        "audience_appropriate_narrative_draft",
        "versioned_deliveryiq_draft"
      ],
      "finalApprovalOutsideTeamMate": true,
      "maximumRisk": "R2"
    },
    {
      "id": "record_exception_review",
      "version": "1.0.0-rc2",
      "trigger": ["explicit_user_request", "approved_visible_schedule"],
      "produces": ["configured_exception", "decisive_facts", "proposed_escalation"],
      "cannot": ["accept_risk", "close_material_record", "make_decision"],
      "maximumRisk": "R1"
    }
  ],
