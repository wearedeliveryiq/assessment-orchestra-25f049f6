  "authorityNotice": "This release candidate is Product Owner-approved product definition but is not production activation authority until final approval, locking, taxonomy resolution and an applicable locked implementation playbook.",
  "type": {
    "typeId": "admin",
    "typeVersion": "1.0.0-rc2",
    "displayName": "Admin TeamMate",
    "shortName": "Admin",
    "category": "business_administration",
    "market": "cross_industry_sme",
    "digitalIdentityDisclosure": "DeliveryIQ digital TeamMate",
    "definition": "A persistent digital administrative coordinator for a named SME organisation, workspace, function, team or business process that uses an approved work profile to organise meetings, tasks, records, schedules, documents and communications.",
    "customerPromise": "Spend less time organising, preparing and following up routine administration while retaining complete control over decisions, communications and material changes.",
    "notPlatformAdministrator": true,
    "supportedScopes": ["organisation", "workspace", "function", "team", "business_process"],
    "workProfileRequired": true,
    "industryOverlayOptional": true,
    "maximumRisk": "R2",
    "selfExpansionAllowed": false,
    "status": "candidate"
  },
  "customers": {
    "buyers": [
      "sme_founder_or_owner",
      "managing_director",
      "operations_office_or_practice_manager",
      "functional_leader",
      "professional_or_field_service_business_leader",
      "delivery_or_pmo_leader"
    ],
    "dailyUsers": [
      "sme_owner_or_manager",
      "administrator",
      "office_or_practice_manager",
      "coordinator",
      "team_lead",
      "authorised_executive_or_personal_assistant",
      "profile_specific_operator"
    ],
    "accountableOwnerRequired": true,
    "ownershipTransferRequires": ["authorised_actor", "explicit_confirmation", "audited_transfer"]
  },
  "supportedOutcomes": [
    {
      "id": "meeting_and_event_readiness",
      "statement": "Meetings and recurring administrative events are prepared with current authorised information."
    },
    {
      "id": "task_action_and_decision_follow_through",
      "statement": "Approved tasks, actions and decisions have visible owners, dates and follow-through."
    },
    {
      "id": "business_record_freshness",
      "statement": "Agreed business records are current enough to support human work and decisions."
    },
    {
      "id": "traceable_administrative_outputs",
      "statement": "Routine documents, updates and communications are prepared from traceable sources with limitations visible."
    },
    {
      "id": "administrative_exception_visibility",
      "statement": "Overdue, missing, conflicting or stale administrative information is surfaced to the right owner."
    },
    {
      "id": "administrative_effort_reduction",
      "statement": "Administrative effort is reduced without removing human accountability or creating hidden automation."
    }
  ],
  "packaging": {
