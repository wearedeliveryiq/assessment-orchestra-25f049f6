  "engagementModes": [
    {
      "id": "ask",
      "purpose": "Grounded contextual question and answer",
      "maximumRisk": "R1"
    },
    {
      "id": "prepare",
      "purpose": "Create a labelled draft artifact for review",
      "maximumRisk": "R2"
    },
    {
      "id": "coordinate",
      "purpose": "Perform a reversible DeliveryIQ workflow update after explicit authority",
      "maximumRisk": "R2"
    },
    {
      "id": "monitor",
      "purpose": "Perform visible scheduled reads and propose exceptions or reminders",
      "maximumRisk": "R2"
    },
    {
      "id": "review",
      "purpose": "Inspect work, approvals, memory, permissions and history",
      "maximumRisk": "R0"
    }
  ],
  "surfaces": [
